+        }
+        Payload::Form { fields, .. } => fields.push(("workspace_id".into(), workspace.to_string())),
+        Payload::None if call.method == Method::POST => call.payload = Payload::Json(json!({ "workspace_id": workspace })),
+        _ => {}
+    }
