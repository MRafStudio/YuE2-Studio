+/// What the user decided about this action in this scope, if they decided anything:
+/// an answer for the session counts inside it, an answer for "always" everywhere.
+async fn remembered_decision(name: &str, scope: &str) -> Option<String> {
+    let list = fetch("/v1/permissions").await;
+    let mut everywhere = None;
+    for entry in list.as_array().into_iter().flatten() {
+        if entry.get("action").and_then(Value::as_str) != Some(name) {
+            continue;
+        }
+        match entry.get("scope").and_then(Value::as_str) {
+            Some(found) if found == scope => return entry.get("decision").and_then(Value::as_str).map(str::to_string),
+            Some("always") => everywhere = entry.get("decision").and_then(Value::as_str).map(str::to_string),
+            _ => {}
+        }
+    }
+    everywhere
+}
+
+/// The leash, in front of every tool that changes something: `free` lets it pass, a
+/// remembered answer is taken as it is, and anything else is put to the user in the
+/// window - once, for the session, always, ask or never. The studio asks BEFORE it
+/// acts, so nothing happens behind the user's back and the agent never widens its
+/// own leash: only the user answers, and only the window records the answer.
+async fn agent_may(name: &str, args: &Value) -> Result<(), String> {
+    let settings = fetch("/v1/agent/leash").await;
+    let leash = settings.get("leash").and_then(Value::as_str).unwrap_or("risky");
+    if leash == "free" {
+        return Ok(());
+    }
+    let guarded = if leash == "all" { !is_read_only(name) } else { is_destructive(name) };
+    if !guarded {
+        return Ok(());
+    }
+    let active = fetch("/v1/workspaces/active").await;
+    let session = active.get("id").and_then(Value::as_str).map(str::to_string);
+    let scope = session.map(|id| format!("session:{id}")).unwrap_or_else(|| "always".into());
+    if let Some(decision) = remembered_decision(name, &scope).await {
+        return if decision == "allow" {
+            Ok(())
+        } else {
+            Err(format!("The user forbade {name} here; agent_permissions lists their decisions."))
+        };
+    }
+    let question = json!({ "action": name, "scope": scope, "details": args });
+    let answer = ask_window("agent_confirm", question, 300).await?;
+    let decision = answer.get("decision").and_then(Value::as_str).unwrap_or("deny");
+    match decision {
+        "once" => Ok(()),
+        "session" | "always" | "deny_always" => {
+            let record = json!({
+                "action": name,
+                "scope": if decision == "always" || decision == "deny_always" { "always" } else { scope.as_str() },
+                "decision": if decision == "deny_always" { "deny" } else { "allow" },
+            });
+            if let Ok(call) = post("/v1/permissions".into(), record) {
+                let _ = call_route(call).await;
+            }
+            if decision == "deny_always" {
+                Err(format!("The user forbade {name}; agent_permissions lists their decisions."))
+            } else {
+                Ok(())
+            }
+        }
+        _ => Err(format!("The user did not answer {name} with a yes; nothing was done.")),
+    }
