-const SESSION_EPOCH = Date.now();
-const NEW_SESSIONS: WorkspaceSession[] = [
-  { id: 'demo-1', name: 'Ночная смена', createdAt: SESSION_EPOCH, closedAt: null },
-  { id: 'demo-2', name: 'Рок-эксперимент', createdAt: SESSION_EPOCH - 86400000, closedAt: SESSION_EPOCH - 3600000 },
-  { id: 'demo-3', name: 'Импорт', createdAt: SESSION_EPOCH - 172800000, closedAt: SESSION_EPOCH - 7200000 },
