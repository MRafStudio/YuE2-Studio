   // a `workspaces` table with the session marked on each track, nothing moving.
-  const [sessions, setSessions] = useState<WorkspaceSession[]>(() => [
-    { id: 'demo-1', name: 'Ночная смена', createdAt: Date.now(), closedAt: null },
-    { id: 'demo-2', name: 'Рок-эксперимент', createdAt: Date.now() - 86400000, closedAt: Date.now() - 3600000 },
-    { id: 'demo-3', name: 'Импорт', createdAt: Date.now() - 172800000, closedAt: Date.now() - 7200000 },
-  ]);
-  const [activeSessionId, setActiveSessionId] = useState<string | null>('demo-1');
+  // What the window remembered last time comes back: closed stays closed.
+  const [restoredSessions] = useState(readStoredSessions);
+  const [sessions, setSessions] = useState<WorkspaceSession[]>(
+    restoredSessions?.sessions ?? NEW_SESSIONS,
+  );
+  const [activeSessionId, setActiveSessionId] = useState<string | null>(
+    restoredSessions ? restoredSessions.activeSessionId : NEW_SESSIONS[0].id,
+  );
   const [sessionView, setSessionView] = useState<SessionView>('session');
   // The list column shows either the tracks or the session browser.
   const [centerView, setCenterView] = useState<'tracks' | 'sessions'>('tracks');
@@ -486,7 +528,9 @@ function AppContent() {
   const [agentAlwaysAllowed, setAgentAlwaysAllowed] = useState<Set<string>>(new Set());
   // Until the service marks tracks, everything the studio makes belongs to the
   // session that was open when it appeared.
-  const [sessionOfTrack, setSessionOfTrack] = useState<Record<string, string>>({});
+  const [sessionOfTrack, setSessionOfTrack] = useState<Record<string, string>>(
+    restoredSessions?.sessionOfTrack ?? {},
+  );
   useEffect(() => {
     setSessionOfTrack((prev) => {
       let changed = false;
@@ -501,6 +545,17 @@ function AppContent() {
     });
   }, [songs, activeSessionId]);
 
+  // Remember the sessions the way the message log is remembered: a reload, a
+  // closed window or a restarted studio must not reopen what was closed.
+  useEffect(() => {
+    try {
+      const stored: StoredSessions = { sessions, activeSessionId, sessionOfTrack };
+      window.localStorage.setItem(SESSIONS_KEY, JSON.stringify(stored));
+    } catch {
+      // blocked or full storage only means no memory, not a broken studio
+    }
+  }, [sessions, activeSessionId, sessionOfTrack]);
+
   const openSession = sessions.find((session) => session.id === activeSessionId) ?? null;
   const tracksInSession = (sessionId: string) =>
     Object.values(sessionOfTrack).filter((value) => value === sessionId).length;
