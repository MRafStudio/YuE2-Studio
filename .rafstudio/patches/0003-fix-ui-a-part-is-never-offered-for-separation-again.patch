 app/components/StudioToolsPanel.tsx | 31 ++++++++++++++++++++---------
 app/components/songParts.tsx        |  3 +++
 app/i18n/en.ts                      |  1 +
 app/i18n/ja.ts                      |  1 +
 app/i18n/ko.ts                      |  1 +
 app/i18n/ru.ts                      |  1 +
 app/i18n/zh.ts                      |  1 +
 8 files changed, 42 insertions(+), 15 deletions(-)

