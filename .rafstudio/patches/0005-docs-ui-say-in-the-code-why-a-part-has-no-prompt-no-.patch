From 88d02ac409391722f47c8520ee5b8a88bf9faa53 Mon Sep 17 00:00:00 2001
From: batya <batya@github.com>
Date: Sun, 27 Sep 2026 17:25:44 +0600
Subject: [PATCH 5/6] docs(ui): say in the code why a part has no prompt, no
 re-render and no second separation
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The rules themselves are one thing; the reasons behind them are what someone
reading this later needs. A stem has no stems inside it and a part never came
from a prompt, so those actions can only make copies of copies or rebuild
something else — and the entries are hidden rather than disabled, the way this
app treats an action that does not apply at all.
---
 app/components/RightSidebar.tsx     |  5 +++++
 app/components/SongDropdownMenu.tsx | 18 +++++++++++-------
 app/components/StudioToolsPanel.tsx |  6 ++++++
 3 files changed, 22 insertions(+), 7 deletions(-)

diff --git a/app/components/RightSidebar.tsx b/app/components/RightSidebar.tsx
index 52e6b95..42ea43b 100644
--- a/app/components/RightSidebar.tsx
+++ b/app/components/RightSidebar.tsx
@@ -427,6 +427,11 @@ export const RightSidebar: React.FC<RightSidebarProps> = ({ song, onClose, onOpe
                         >
                             <Edit3 size={18} strokeWidth={1.5} />
                         </button>
+                        {/* A part is the result of a separation, not of a prompt:
+                            it has no prompt to repeat and no stems to take, so
+                            both buttons would offer work that cannot come out
+                            right. Hidden, not disabled — the app hides what does
+                            not apply instead of promising it. */}
                         {!songIsPart && (
                             <>
                                 <button
diff --git a/app/components/SongDropdownMenu.tsx b/app/components/SongDropdownMenu.tsx
index 6fdca9f..0725a9b 100644
--- a/app/components/SongDropdownMenu.tsx
+++ b/app/components/SongDropdownMenu.tsx
@@ -245,9 +245,13 @@ export const SongDropdownMenu: React.FC<SongDropdownMenuProps> = ({
                     disabled={!song.audioUrl}
                 />
             )}
-            {/* A part is already the result of a separation: offering to split
-                it again only ever makes copies of copies, so the item is not
-                there at all for a part. */}
+            {/* A part is already the result of a separation, and it never had a
+                prompt of its own: splitting it again, repeating its prompt or
+                re-rendering it only ever make copies of copies — junk in the
+                library, extra files on disk, minutes of GPU time. The items are
+                hidden rather than disabled: that is how this app treats an
+                action that does not apply (see the karaoke item), so the menu
+                never offers work that cannot mean anything. */}
             {!songIsPart && (
                 <MenuItem
                     icon={<Scissors size={14} />}
@@ -280,10 +284,10 @@ export const SongDropdownMenu: React.FC<SongDropdownMenuProps> = ({
                     />
                 </>
             )}
-            {/* A part is already the result of a separation, and it never had a
-                prompt of its own: splitting it again, repeating its prompt or
-                re-rendering it only ever make copies of copies, so none of
-                those items is there for a part. */}
+            {/* A part came out of a separation, not out of a prompt, so reusing
+                its prompt or re-rendering it would either borrow the base
+                song's prompt or rebuild something else entirely — misleading
+                rather than merely useless. */}
             {!songIsPart && actions.reusePrompt && (
                 <MenuItem
                     icon={<Repeat size={14} />}
diff --git a/app/components/StudioToolsPanel.tsx b/app/components/StudioToolsPanel.tsx
index 66a0dee..8ec2a44 100644
--- a/app/components/StudioToolsPanel.tsx
+++ b/app/components/StudioToolsPanel.tsx
@@ -326,6 +326,12 @@ export function StudioToolsPanel({ initialSongId }: { initialSongId?: string | n
               <p className="mt-2 text-xs leading-5 text-zinc-500 dark:text-zinc-400">{t('separationQualityHint')}</p>
             </div>
 
+            {/* A part has no stems inside it (a drum track cannot be split into
+                drums, bass and vocals), so for one the button gives way to the
+                reason. Not greyed out and not empty: this track list is shared
+                with the MIDI, editor, processing and transcription tools, where
+                a part is a perfectly good choice, and a dead button here would
+                read as the tool being broken. */}
             {selectedIsPart ? (
               <p className="mt-3 rounded-lg border border-zinc-200 px-3 py-2 text-xs leading-5 text-zinc-500 dark:border-white/10 dark:text-zinc-400">
                 {t('stemsPartCannot')}
-- 
