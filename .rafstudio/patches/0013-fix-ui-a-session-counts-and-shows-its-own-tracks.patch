From 0384514ca71e57ed45d63260dfb7c3d049273dfa Mon Sep 17 00:00:00 2001
From: batya <batya@github.com>
Date: Sun, 27 Sep 2026 20:20:02 +0600
Subject: [PATCH 13/16] fix(ui): a session counts and shows its own tracks

The count and the list came from one shared map of "which session a track is in",
where the last session in the array won: a track kept in two sessions was counted
for one of them, and the other looked empty even though its own list was full.
Both now read the session's own list, so the number shown always matches what is
under it. The local-storage session store that the service replaced - never
called since - goes away with the map.
---
 app/App.tsx | 71 +++++++++++------------------------------------------
 1 file changed, 14 insertions(+), 57 deletions(-)

diff --git a/app/App.tsx b/app/App.tsx
index 42a26db..1da7011 100644
--- a/app/App.tsx
+++ b/app/App.tsx
@@ -146,48 +146,8 @@ function loadNativeLikedSongIds(): Set<string> {
   }
 }
 
-/// A session name is unique, as a file name is: a repeat becomes "Rock (2)",
-/// Sessions, and which one is open, are remembered by the window itself until the
-/// service owns them (stage 2). The author stores theme, language and volume the
-/// same way, so a reload must not undo what the user did - a session closed in the
-/// library came back open, which is simply wrong.
-const SESSIONS_KEY = 'sessions';
-
-interface StoredSessions {
-  sessions: WorkspaceSession[];
-  activeSessionId: string | null;
-  sessionOfTrack: Record<string, string>;
-}
-
-const readStoredSessions = (): StoredSessions | null => {
-  try {
-    const raw = window.localStorage.getItem(SESSIONS_KEY);
-    if (!raw) return null;
-    const parsed = JSON.parse(raw) as Partial<StoredSessions>;
-    if (!Array.isArray(parsed.sessions) || parsed.sessions.length === 0) return null;
-    return {
-      sessions: parsed.sessions,
-      activeSessionId: typeof parsed.activeSessionId === 'string' ? parsed.activeSessionId : null,
-      sessionOfTrack: parsed.sessionOfTrack && typeof parsed.sessionOfTrack === 'object'
-        ? parsed.sessionOfTrack
-        : {},
-    };
-  } catch {
-    // unreadable storage counts as empty: the starting sessions come back
-    return null;
-  }
-};
