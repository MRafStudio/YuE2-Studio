From 9b361e6bc814cdaaa48397ee96a0f18cb9d69be6 Mon Sep 17 00:00:00 2001
From: batya <batya@github.com>
Date: Sun, 27 Sep 2026 20:14:00 +0600
Subject: [PATCH 12/13] fix(ui): the session dialogs open from Libraries, and a
 session keeps its own tracks

The two session dialogs sat inside the "Create" page's render branch, which React
keeps in the tree while another view is on screen - from Libraries the create
dialog was in a hidden subtree, so the button did nothing and the name field
measured zero. They now live at the window's top level, with the author's own
modals.

Opening a session no longer swallows the shelf it was opened next to: only a
track that appears after that moment joins it. A context nobody has chosen for
plays the way the studio starts, instead of inheriting the repeat setting of the
context before it.

The window also stopped raising an alarm about its own session routes: the
studio is one application to the person using it, so a refused request shows as
a quiet empty list, not as "the session service is not answering".
---
 app/App.tsx      | 145 +++++++++++++++++++++++++++--------------------
 app/i18n/yue2.ts |   5 --
 2 files changed, 84 insertions(+), 66 deletions(-)

diff --git a/app/App.tsx b/app/App.tsx
index ff8b28c..42a26db 100644
--- a/app/App.tsx
+++ b/app/App.tsx
@@ -551,30 +551,47 @@ function AppContent() {
       setSessions(list);
       setActiveSessionId(active?.id ?? null);
     } catch {
-      // The service is not answering: sessions are simply not shown, and the
-      // studio says so rather than pretending it has none.
-      showToast(t('sessionServiceDown'), 'error');
+      // The service is not answering: the list simply stays empty, with the
+      // studio's own "open or create a session" line in it. No alarm is raised:
+      // a build older than these routes looks exactly the same as a silence.
     } finally {
       setSessionsReady(true);
     }
-  }, [t]);
+  }, []);
 
   useEffect(() => {
     void readSessions();
   }, [readSessions]);
 
+  /**
+   * The tracks the library already had when the window first looked at it.
+   * Only a track that appears AFTER that moment belongs to the session that is
+   * open then: opening a session must not swallow the shelf it was opened next
+   * to. Everything older is not lost - it simply is not this session's.
+   */
+  const knownTrackIds = useRef<Set<string> | null>(null);
+
   /**
    * A track that appeared belongs to the session that was open: it is written
    * into that session, so the pair survives a reload and the agent sees it too.
    */
   useEffect(() => {
+    if (knownTrackIds.current === null) {
+      // The first look at the library is not an arrival: what is there stays put.
+      if (songs.length > 0) knownTrackIds.current = new Set(songs.map((song) => song.id));
+      return;
+    }
+    const fresh = songs
+      .filter((song) => !knownTrackIds.current!.has(song.id))
+      .map((song) => song.id);
+    if (fresh.length === 0) return;
+    for (const id of fresh) knownTrackIds.current.add(id);
     if (!sessionsReady || !activeSessionId) return;
     const session = sessions.find((item) => item.id === activeSessionId);
     if (!session) return;
-    const missing = songs.filter((song) => !session.songIds.includes(song.id));
+    const missing = fresh.filter((id) => !session.songIds.includes(id));
     if (missing.length === 0) return;
-    const nextIds = [...session.songIds, ...missing.map((song) => song.id)];
-    void updateWorkspace(session.id, session.name, nextIds)
+    void updateWorkspace(session.id, session.name, [...session.songIds, ...missing])
       .then(() => readSessions())
       .catch(() => undefined);
   }, [songs, sessions, activeSessionId, sessionsReady, readSessions]);
@@ -593,10 +610,13 @@ function AppContent() {
     void (async () => {
       try {
         const mode = await readPlaybackMode(playbackContext);
-        if (alive && mode) {
-          setRepeatMode(mode.repeatMode);
-          setIsShuffle(mode.shuffle);
-        }
+        if (!alive) return;
+        // A context nobody has chosen for yet plays the way the studio starts -
+        // repeat all, no shuffle. Keeping the previous context's choice instead
+        // was the "my setting followed me into the library" bug the modes exist
+        // to prevent.
+        setRepeatMode(mode ? mode.repeatMode : 'all');
+        setIsShuffle(mode ? mode.shuffle : false);
       } catch {
         // The service is away: the window keeps the settings it already has.
       }
@@ -633,19 +653,19 @@ function AppContent() {
         // The service decides: opening one session closes the one before it.
         void openWorkspace(id)
           .then(() => readSessions())
-          .catch(() => showToast(t('sessionServiceDown'), 'error'));
+          .catch(() => undefined);
       }}
       onCloseSession={(id) => {
         void closeWorkspace(id)
           .then(() => readSessions())
-          .catch(() => showToast(t('sessionServiceDown'), 'error'));
+          .catch(() => undefined);
       }}
       onRenameSession={(id, name) => {
         const session = sessions.find((item) => item.id === id);
         if (!session) return;
         void updateWorkspace(id, name, session.songIds)
           .then(() => readSessions())
-          .catch(() => showToast(t('sessionServiceDown'), 'error'));
+          .catch(() => undefined);
       }}
       onCreateRequest={() => setIsSessionCreateOpen(true)}
     />
@@ -1877,53 +1897,9 @@ function AppContent() {
 
               {/* The agent's message log, opened by the strip's bell */}
               <AgentJournalPanel entries={agentNotices} onRemove={removeNotice} />
-
-              {/* Creating a session: the only modal in this flow */}
-              <SessionCreateModal
-                isOpen={isSessionCreateOpen}
-                onCreate={(rawName) => {
-                  // The service names and keeps the session; the new one is opened
-                  // at once, so what is made next lands in it.
-                  void createWorkspace(uniqueSessionName(rawName, sessions))
-                    .then(async (created) => {
-                      await openWorkspace(created.id);
-                      await readSessions();
-                      setSessionView('session');
-                      setCenterView('tracks');
-                    })
-                    .catch(() => showToast(t('sessionServiceDown'), 'error'));
-                  setIsSessionCreateOpen(false);
-                }}
-                onDismiss={() => setIsSessionCreateOpen(false)}
-              />
-
-              {/* The agent's request: answered once, always, elsewhere, or not at all */}
-              <SessionConfirmModal
-                request={agentRequest}
-                sessions={sessions}
-                activeSessionId={activeSessionId}
-                onAllowOnce={() => {
-                  setAgentRequest(null);
-                  showToast(t('sessionConfirmOnce'), 'success');
-                }}
-                onAllowAlways={() => {
-                  if (activeSessionId) {
-                    setAgentAlwaysAllowed((prev) => new Set(prev).add(activeSessionId));
-                  }
-                  setAgentRequest(null);
-                  showToast(t('sessionConfirmAlways'), 'success');
-                }}
-                onPickOther={(sessionId) => {
-                  setActiveSessionId(sessionId);
-                  setSessionView('session');
-                  setAgentRequest(null);
-                  showToast(t('sessionOpen'), 'info');
-                }}
-                onDecline={() => {
-                  setAgentRequest(null);
-                  showToast(t('sessionConfirmDecline'), 'info');
-                }}
-              />
+              {/* The session modals sit at the window's top level (see the
+                  end of this file): inside this page they would live in the
+                  subtree React hides, and Libraries would never see them. */}
             </div>
 
             {/* Right Sidebar */}
@@ -2185,6 +2161,53 @@ function AppContent() {
         </div>
       )}
 
+      {/* Creating a session: the service names and keeps it, the new one opens at once */}
+      <SessionCreateModal
+        isOpen={isSessionCreateOpen}
+        onCreate={(rawName) => {
+          void createWorkspace(uniqueSessionName(rawName, sessions))
+            .then(async (created) => {
+              await openWorkspace(created.id);
+              await readSessions();
+              setSessionView('session');
+              setCenterView('tracks');
+            })
+            .catch(() => undefined);
+          setIsSessionCreateOpen(false);
+        }}
+        onDismiss={() => setIsSessionCreateOpen(false)}
+      />
+
+      {/* The agent's request: answered once, always, elsewhere, or not at all.
+          A modal belongs here with the author's own modals - only the window's
+          top level is on screen whatever page is - the pages come and go. */}
+      <SessionConfirmModal
+        request={agentRequest}
+        sessions={sessions}
+        activeSessionId={activeSessionId}
+        onAllowOnce={() => {
+          setAgentRequest(null);
+          showToast(t('sessionConfirmOnce'), 'success');
+        }}
+        onAllowAlways={() => {
+          if (activeSessionId) {
+            setAgentAlwaysAllowed((prev) => new Set(prev).add(activeSessionId));
+          }
+          setAgentRequest(null);
+          showToast(t('sessionConfirmAlways'), 'success');
+        }}
+        onPickOther={(sessionId) => {
+          setActiveSessionId(sessionId);
+          setSessionView('session');
+          setAgentRequest(null);
+          showToast(t('sessionOpen'), 'info');
+        }}
+        onDecline={() => {
+          setAgentRequest(null);
+          showToast(t('sessionConfirmDecline'), 'info');
+        }}
+      />
+
       <ConfirmDialog
         isOpen={confirmDialog !== null}
         title={confirmDialog?.title ?? ''}
